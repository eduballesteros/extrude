# Claves de IA de Extrude. Este archivo se queda en este ordenador: no se comparte ni se sube.
#
# Pega cada clave tras el "=" (sin comillas ni espacios), guarda y vuelve a abrir Extrude.
# Deja vacías las que no uses. Cada consulta o imagen puede tener coste en tu cuenta.

# Claude (mejorar textos y editar el proyecto): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (generar imágenes): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (generar imágenes): https://aistudio.google.com/apikey
GEMINI_API_KEY=
