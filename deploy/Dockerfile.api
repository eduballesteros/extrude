# Versiones deliberadas; fijar también digests en una release validada (ver README).
FROM ghcr.io/astral-sh/uv:0.13.7 AS uv
FROM node:22.22.0-bookworm-slim AS tools
WORKDIR /opt/extrude/tools
COPY tools/package*.json ./
RUN npm ci --omit=dev
COPY tools/*.mjs ./

FROM python:3.12.13-slim-bookworm AS python-build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/extrude/pipeline
COPY pipeline/pyproject.toml pipeline/uv.lock ./
COPY pipeline/src ./src
RUN uv sync --locked --no-dev --extra ai --no-editable

FROM python:3.12.13-slim-bookworm AS runtime
ENV PATH="/opt/extrude/pipeline/.venv/bin:$PATH" \
    EXTRUDE_TOOLS_DIR=/opt/extrude/tools \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 extrude && useradd --uid 10001 --gid 10001 --no-create-home extrude \
    && mkdir -p /data/jobs /data/accounts && chown -R 10001:10001 /data
COPY --from=python-build /opt/extrude/pipeline/.venv /opt/extrude/pipeline/.venv
COPY --from=tools /usr/local/bin/node /usr/local/bin/node
COPY --from=tools /opt/extrude/tools /opt/extrude/tools
COPY deploy/runtime.py /opt/extrude/runtime.py
COPY deploy/maintenance.py /opt/extrude/maintenance.py
USER 10001:10001
WORKDIR /data
ENTRYPOINT ["python", "/opt/extrude/runtime.py"]
