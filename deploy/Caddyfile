{
    admin off
    email {$ACME_EMAIL}
    http_port 8080
    https_port 8443
    servers {
        timeouts {
            read_header 10s
            read_body 120s
            idle 120s
        }
    }
}

{$EXTRUDE_DOMAIN} {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    encode zstd gzip
    @api path /api /api/*
    handle @api {
        header Cache-Control no-store
        request_body {
            max_size 104857600
        }
        reverse_proxy api:8765 {
            transport http {
                dial_timeout 5s
                response_header_timeout 900s
            }
        }
    }
    handle {
        root * /srv
        # Sin fallback SPA ni listados: guía, modelos y decodificadores son archivos reales.
        file_server
    }
}
