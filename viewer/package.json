{
  "name": "extrude-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-decoders.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-decoders.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "suncalc": "1.9.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/suncalc": "1.9.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
